{
  "ConnectionStrings": {
    "Platform": "Data Source=App_Data/platform.db"
  },
  "Platform": {
    "AppsDirectory": "",
    "SeedBase": 4242,
    "Session": { "IdleMinutes": 30, "AbsoluteHours": 8 },
    "RateLimits": { "LoginPerMinute": 20, "MutationsPerMinute": 120 },
    "Outbox": { "RelayIntervalSeconds": 2 },
    "Telemetry": { "ConsoleTraces": true }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
