{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@platform/sdk": ["./platform/web/src/sdk/index.ts"]
    }
  },
  "include": [
    "platform/web/**/*.ts",
    "platform/web/**/*.tsx",
    "apps/*/web/**/*.ts",
    "apps/*/web/**/*.tsx",
    "tests/web/**/*.ts",
    "tests/web/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/wwwroot", "**/bin", "**/obj"]
}
